{
  "version": 6,
  "configurePresets": [
    {
      "name": "windows",
      "displayName": "Windows (Zig's clang, fetched automatically)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/cmake",
      "toolchainFile": "${sourceDir}/cmake/zig-toolchain.cmake",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "mac",
      "displayName": "macOS (Apple's clang from the Xcode command line tools)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/cmake",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "CMAKE_OSX_DEPLOYMENT_TARGET": "13.3" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" }
    }
  ],
  "buildPresets": [
    { "name": "windows", "configurePreset": "windows" },
    { "name": "mac", "configurePreset": "mac" }
  ],
  "testPresets": [
    { "name": "windows", "configurePreset": "windows", "output": { "outputOnFailure": true } },
    { "name": "mac", "configurePreset": "mac", "output": { "outputOnFailure": true } }
  ]
}
