{
  "version": 6,
  "configurePresets": [
    {
      "name": "windows",
      "displayName": "Windows (Zig's clang, fetched automatically)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/cmake",
      "toolchainFile": "${sourceDir}/cmake/zig-toolchain.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "mac",
      "displayName": "macOS (Apple's clang from the Xcode command line tools)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "13.3"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows",
      "configurePreset": "windows"
    },
    {
      "name": "mac",
      "configurePreset": "mac"
    },
    {
      "name": "windows-install",
      "configurePreset": "windows",
      "targets": [
        "install_sessionscope"
      ]
    },
    {
      "name": "mac-install",
      "configurePreset": "mac",
      "targets": [
        "install_sessionscope"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "windows",
      "configurePreset": "windows",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "exclude": {
          "label": "plugins"
        }
      }
    },
    {
      "name": "windows-plugins",
      "configurePreset": "windows",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "plugins"
        }
      }
    },
    {
      "name": "mac",
      "configurePreset": "mac",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "exclude": {
          "label": "plugins"
        }
      }
    },
    {
      "name": "mac-plugins",
      "configurePreset": "mac",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "plugins"
        }
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "windows",
      "displayName": "Set up, build, test and install",
      "steps": [
        {
          "type": "configure",
          "name": "windows"
        },
        {
          "type": "build",
          "name": "windows"
        },
        {
          "type": "test",
          "name": "windows"
        },
        {
          "type": "build",
          "name": "windows-install"
        }
      ]
    },
    {
      "name": "mac",
      "displayName": "Set up, build, test and install",
      "steps": [
        {
          "type": "configure",
          "name": "mac"
        },
        {
          "type": "build",
          "name": "mac"
        },
        {
          "type": "test",
          "name": "mac"
        },
        {
          "type": "build",
          "name": "mac-install"
        }
      ]
    }
  ]
}
