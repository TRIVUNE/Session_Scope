# =================================================================================================
# embed_fonts.cmake - turns the HUD's font files into C++ source, so the fonts live inside the .exe
# =================================================================================================
#
# Run by the build (engine/CMakeLists.txt), not by hand:
#   cmake -DOUT=<fonts_data.cpp> -DLIST=<fonts.list> -P embed_fonts.cmake
# where fonts.list has one "NAME=font file" per line, for example
#   INTER_REGULAR=C:/.../Inter-Regular.ttf
#
# Each font file becomes a list of its bytes ("0x4f,0x54,...") in a generated .cpp file that defines
# the names declared in engine/hud/look/fonts_data.h. The HUD then needs no font files beside it.

set(text "// Generated by cmake/embed_fonts.cmake from .toolchain/inter. Do not edit.\n")
string(APPEND text "#include \"look/fonts_data.h\"\n\nnamespace sessionscope {\n\n")
file(STRINGS "${LIST}" entries)   # one entry per line
foreach(entry IN LISTS entries)
  string(REPLACE "=" ";" parts "${entry}")
  list(GET parts 0 name)
  list(GET parts 1 file)
  string(TOLOWER "${name}" lower)
  file(READ "${file}" hex HEX)                                         # the bytes, as hexadecimal text
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")   # "4f54" -> "0x4f,0x54,"
  string(APPEND text "static const unsigned char ${lower}_bytes[] = {${bytes}};\n")
  string(APPEND text "const EmbeddedFont ${name} = {${lower}_bytes, sizeof(${lower}_bytes)};\n\n")
endforeach()
string(APPEND text "}  // namespace sessionscope\n")
file(WRITE "${OUT}" "${text}")
